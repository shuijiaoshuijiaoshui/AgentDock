# ===== 业务库（域 + console 共用；生产换 Postgres）=====
BUSINESS_DB_PATH=infra/mockdata/mock.db

# ===== LLM（智谱 GLM，OpenAI 兼容端点）=====
# 智谱开放平台 https://open.bigmodel.cn 申请；不填则必须用 LLM_PROVIDER=fake
ZHIPUAI_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_SMALL_MODEL=glm-4.6
LLM_MAIN_MODEL=glm-4.6
# openai = 真实调用智谱；fake = 不调真模型（脚本化返回，跑通链路/跑测试）
LLM_PROVIDER=openai

# ===== 状态持久化 =====
# sqlite = 本机零依赖可跑；postgres = 生产口径（infra/docker-compose.yml 里的 PG）
CHECKPOINTER=sqlite
SQLITE_DB_PATH=.data/checkpoints.sqlite
POSTGRES_DSN=postgresql://agentdock:agentdock@localhost:5433/agentdock
# M1 的 TaskStore 与 checkpointer 同库（sqlite 路径 / postgres DSN 共用）

# ===== 服务与安全 =====
# dev / test / prod；prod 会拒绝默认 AUTH_SECRET / CARD_SIGNING_KEY
ENV=dev
DEV_MODE=true
# JWT 签名密钥：生产必须换成 KMS 或至少强随机值（openssl rand -hex 32）
AUTH_SECRET=dev-jwt-secret-change-me
AUTH_ISSUER=agentdock
AUTH_TOKEN_TTL_MINUTES=480
# env = 环境变量/本地文件；kms = 需实现 shared/keys.py 的 KMSKeyProvider
KEY_PROVIDER=env
KEY_VERSION=v1
CARD_SIGNING_KEY=dev-card-signing-key
CARD_SIGNING_KEY_FILE=infra/keys/card_signing_key.pem
# M4：Card JWS 签发/验签（ES256，scripts/gen_keys.py 生成密钥对）
CARD_SIGNING_ENABLED=true
CARD_VERIFY_ENABLED=true
# Card 缓存 TTL（秒，PRD 7.3.1 拉取并缓存 5 分钟）
CARD_CACHE_TTL_SECONDS=300
# kid 轮换：历史公钥映射 {"v1": "<PEM 内容或公钥文件路径>"}（JSON，引号转义）
CARD_VERIFY_KEYS_JSON=
# 审计/审批共享库（所有服务必须指向同一文件；Docker 用共享卷）
SHARED_DB_PATH=.data/shared.db
# securityd（审计/审批/确认单写者）：local 只用于单测；dev_all/compose 用 remote
SECURITY_MODE=local
SECURITY_DB_PATH=.data/security.db
SECURITY_PORT=8309
SECURITY_URL=
AUDIT_SIGNING_KEY=dev-audit-signing-key
# 同源反代/公网 Origin（逗号分隔）；空 = 本机 console 端口
ALLOWED_ORIGINS=
# Cookie Path：本地直连 /；商家反代 /support
COOKIE_PATH=/
# 旧版 INTERNAL_TOKEN 仅保留给迁移脚本；新链路不再作为业务身份
INTERNAL_TOKEN=dev-internal-token

# PII / 限流
PII_MASKING_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WS_PER_MINUTE=60

# ===== OTel 跨进程 trace（M4 / PRD 7.10）=====
# 默认关（零导入零开销）；dev_all 会强制开。span 按服务落 TRACE_DIR/*.jsonl，
# console GET /api/traces/{trace_id} 汇总重建调用树。多机部署需共享 TRACE_DIR。
TRACING_ENABLED=false
# 头部采样比例（按 trace_id 确定性）；异常全采需 collector 级尾采样（未接）
TRACING_SAMPLE_RATIO=1.0
TRACE_DIR=.data/traces
# 本进程服务名（dev_all/compose 注入；span 归档与 resource 属性用）
SERVICE_NAME=

# 金额阈值与审批（元）
APPROVAL_REFUND_THRESHOLD=500
APPROVAL_PRICE_CHANGE_THRESHOLD=500
APPROVAL_INVOICE_THRESHOLD=1000
APPROVAL_DUAL_THRESHOLD_MULTIPLIER=5
APPROVAL_TTL_MINUTES=30

ORCHESTRATOR_PORT=8300
MERCHANDISING_PORT=8301
CUSTOMER_PORT=8308
# 营销经营分析域（投流/选品/竞品/爆款，商家服务端 toB）
MARKETING_PORT=8310
ORDER_PORT=8302
FULFILLMENT_PORT=8303
AFTERSALE_PORT=8304
FINANCE_PORT=8305
POLICY_PORT=8306
# 人工坐席工作台（A2A handoff.accept + 工作台页 / + 模拟客户页 /customer）
CONSOLE_PORT=8307

# ===== 政策检索 / 向量索引（可选）=====
# keyword = 强证据关键词（默认，零依赖）；hybrid = 关键词 + pgvector 语义召回
POLICY_RETRIEVER=keyword
# 向量索引库（空 = 沿用 POSTGRES_DSN；compose 的 pgvector 镜像已含扩展）
POLICY_VECTOR_DSN=
# local = 本地 ONNX 模型（需 uv pip install -r requirements-embeddings.txt）
# fake  = 确定性测试替身（仅测试/离线，不是语义模型）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_CACHE_DIR=.data/models
# 向量召回最低余弦相似度（低于则丢弃）
POLICY_VECTOR_MIN_SCORE=0.35
# 单条款切分上限（字符）；超长按空行分段
POLICY_CHUNK_MAX_CHARS=1200
